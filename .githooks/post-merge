#!/bin/bash
# post-merge hook: 在 git pull / merge 完成后，自动同步配置的上游技能源
# 目前支持: officecli (iOfficeAI/OfficeCLI)、science-skills (google-deepmind/science-skills)
# 通过 scripts/sync_skills.sh 拉取最新内容，有变更则自动提交

set -e

cd "$(git rev-parse --show-toplevel)"

# 继承当前 shell 的代理配置（如有），避免上游 clone 挂起
export https_proxy="${https_proxy:-}"
export http_proxy="${http_proxy:-}"
export all_proxy="${all_proxy:-}"

if [ ! -f "scripts/sync_skills.sh" ] || [ ! -f "skills_sources.json" ]; then
    exit 0
fi

# 定义需要自动同步的上游源（对应 skills_sources.json 中的 name）
SOURCES=("officecli" "science-skills" "anysearch")

for src in "${SOURCES[@]}"; do
    if ! grep -q "\"$src\"" "skills_sources.json"; then
        continue
    fi

    echo "⟳ post-merge: 同步 $src 上游..."

    if bash scripts/sync_skills.sh "$src"; then
        if [ -n "$(git status --porcelain skills/)" ]; then
            git add skills/ skills_sources.json
            git commit -m "chore(sync): auto-sync $src from upstream [skip ci]" --no-verify
            echo "✅ $src 已同步并提交"
        else
            echo "✅ $src 已是最新"
        fi
    fi
done
